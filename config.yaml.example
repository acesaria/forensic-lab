# config.yaml
# Machine-specific environment settings. Edit these per host.

host:
  ssh_key: ~/.ssh/forensics-lab
  ssh_pub_key: ~/.ssh/forensics-lab.pub
  libvirt_uri: qemu:///system
  isolated_network_name: forensics-isolated
  nat_network_name: default
  pool_name: forensic-lab-pool
  # ProjectPaths derives disks/ and images/ beneath this host-local root.
  state_dir: /var/lib/forensic-lab
  shared_dir: ./shared
  # Raw extraction tools may be command names or absolute paths.
  vol_bin: vol3
  mmls_bin: mmls
  fls_bin: fls
  fsstat_bin: fsstat
  log2timeline_bin: log2timeline
  psort_bin: psort

role_defaults:
  lab:
    disk_size: 10G
    ram_mb: 2048
    vcpus: 2
  build-isf:
    disk_size: 25G
    ram_mb: 6144
    vcpus: 4
