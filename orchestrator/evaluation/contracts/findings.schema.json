{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "findings.schema.json",
  "title": "Finding (one per line in findings.jsonl)",
  "type": "object",
  "required": [
    "finding_id",
    "source_tool",
    "detector",
    "rule_layer",
    "event_class",
    "ts_quality",
    "entity"
  ],
  "additionalProperties": true,
  "properties": {
    "finding_id": {"type": "string"},
    "source_tool": {"type": "string", "enum": ["plaso", "vol3", "tsk"]},
    "detector": {"type": "string"},
    "rule_layer": {"type": "string", "enum": ["community", "custom"]},
    "technique": {"type": ["string", "null"]},
    "event_class": {
      "type": "string",
      "enum": [
        "file_created",
        "file_deleted",
        "file_modified",
        "process_exec",
        "persistence_installed",
        "network_connection",
        "auth_login",
        "log_tampering",
        "history_cleared"
      ]
    },
    "ts_utc": {
      "type": ["string", "null"]
    },
    "ts_quality": {"type": "string", "enum": ["wallclock", "relative", "none"]},
    "entity": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": true,
      "properties": {
        "type": {"type": "string", "enum": ["path", "process", "user", "socket"]},
        "value": {"type": ["string", "integer"]}
      }
    },
    "raw_ref": {"type": ["string", "null"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
  }
}
